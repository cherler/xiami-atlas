{
  "name": "xiamimate-ai-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3400",
    "build": "next build",
    "start": "next start -p 3400",
    "validate": "node scripts/validate.mjs",
    "prebuild": "node scripts/validate.mjs && node scripts/alert.mjs",
    "package": "bash scripts/package.sh",
    "watch": "node scripts/watch.mjs --due",
    "gateway": "node scripts/local-gateway.mjs",
    "gateway:static": "node scripts/local-gateway.mjs --main=static --atlas=static",
    "modelscope": "node scripts/modelscope.mjs --json",
    "diagrams": "node scripts/make-diagrams.mjs",
    "diagrams:check": "node scripts/diagram-contrast.mjs",
    "topic:tabs": "node scripts/topic-tabs.mjs",
    "tutorials:check": "node scripts/tutorials-check.mjs",
    "deepwiki": "node scripts/deepwiki.mjs",
    "readme": "node scripts/fetch-readme.mjs",
    "basepath": "node scripts/basepath-check.mjs",
    "repos": "node scripts/refresh-repos.mjs",
    "fresh": "node scripts/fresh.mjs",
    "readme:drift": "node scripts/readme-drift.mjs",
    "film:capture": "node scripts/film-capture.mjs",
    "film:audio": "node scripts/film-audio.mjs",
    "film:cut": "node scripts/film-cut.mjs",
    "film:mix": "node scripts/film-mix.mjs",
    "test:rules": "node scripts/test-rules.mjs",
    "verify": "node scripts/verify.mjs",
    "station": "node scripts/review-ui.mjs",
    "todo": "node scripts/todo.mjs",
    "alert": "node scripts/alert.mjs"
